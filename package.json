{
  "name": "expense-tracker-pro",
  "private": true,
  "version": "1.0.0",
  "description": "A full-stack expense tracking application",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev:migrate": "pnpm --filter server dev:migrate",
    "dev:generate": "pnpm --filter server dev:generate",
    "dev:seed": "pnpm --filter server dev:seed",
    "dev:seed:reset": "pnpm --filter server dev:seed:reset",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
