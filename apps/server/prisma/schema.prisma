// ─── Datasource & Generator ──────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentMethodType {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  DIGITAL_WALLET
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_CRITICAL
  EXPORT_COMPLETE
  WEEKLY_DIGEST
}

enum Currency {
  USD
  EUR
  GBP
  EGP
  CAD
  AUD
  JPY
  CHF
  CNY
  INR
  BRL
  MXN
  KRW
  SEK
  NOK
  DKK
  NZD
  SGD
  HKD
  SAR
  AED
}

// ─── Models ──────────────────────────────────────────────────

/// Registered application user.
model User {
  /// Unique user identifier (UUID v4).
  id        String   @id @default(uuid()) @db.Uuid

  /// Unique email address used for login and communication.
  email     String   @unique

  /// Bcrypt-hashed password (never stored in plain text).
  passwordHash String

  /// Optional display name shown in profile and UI.
  name      String?

  /// Optional short biography.
  bio       String?

  /// Optional URL to the user's avatar image.
  avatarUrl String?

  /// Preferred currency for displaying monetary values.
  currency  Currency @default(USD)

  /// Preferred locale string (e.g. "en-US", "ar-EG").
  language  String   @default("en-US")

  /// Preferred date format string (e.g. "YYYY-MM-DD", "MM/DD/YYYY").
  dateFormat String  @default("YYYY-MM-DD")

  /// JSON object storing notification preference flags:
  ///   { "budgetAlerts": bool, "emailWarnings": bool, "weeklyDigest": bool }
  notificationPreferences Json  @default("{\"budgetAlerts\":true,\"emailWarnings\":true,\"weeklyDigest\":false}")

  /// Whether the user's email address has been verified.
  emailVerified Boolean @default(false)

  /// Timestamp of account creation.
  createdAt DateTime @default(now())

  /// Timestamp of the last update to any user field.
  updatedAt DateTime @updatedAt

  /// The user's custom spending categories.
  categories Category[]

  /// The user's saved payment methods.
  paymentMethods PaymentMethod[]

  /// The user's financial transactions.
  transactions Transaction[]

  /// The user's budget targets per category and period.
  budgets Budget[]

  /// The user's in-app notifications.
  notifications Notification[]

  /// The user's savings goals.
  savingsGoals SavingsGoal[]

  /// Index for efficient querying and sorting by creation date.
  @@index([createdAt])

  /// Map the model to the "users" table in PostgreSQL.
  @@map("users")
}

/// Spending category associated with a user.
model Category {
  /// Unique category identifier (UUID v4).
  id        String  @id @default(uuid()) @db.Uuid

  /// Display name of the category (e.g. "Food & Dining", "Transportation").
  name      String

  /// Lucide icon identifier for the category.
  icon      String  @default("Tag")

  /// Hex color code for the category (e.g. "#F59E0B").
  color     String  @default("#6366F1")

  /// Whether this is a predefined system category (protected from deletion).
  isSystem  Boolean @default(false)

  /// Foreign key to the owning user.
  userId    String  @db.Uuid

  /// The user who owns this category.
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Transactions assigned to this category.
  transactions Transaction[]

  /// Budget targets set for this category.
  budgets Budget[]

  /// Timestamp of category creation.
  createdAt DateTime @default(now())

  /// Timestamp of the last update to any category field.
  updatedAt DateTime @updatedAt

  /// Category names must be unique per user.
  @@unique([name, userId])

  /// Index for querying categories by user.
  @@index([userId])

  /// Map the model to the "categories" table in PostgreSQL.
  @@map("categories")
}

/// Saved payment method associated with a user.
model PaymentMethod {
  /// Unique payment method identifier (UUID v4).
  id        String           @id @default(uuid()) @db.Uuid

  /// The type of payment method.
  type      PaymentMethodType

  /// User-friendly label (e.g. "My Chase Credit Card", "Personal Checking").
  name      String

  /// Whether this is the user's default payment method.
  isDefault Boolean          @default(false)

  /// Optional last 4 digits of the card or account number for display.
  lastFour  String?

  /// Foreign key to the owning user.
  userId    String           @db.Uuid

  /// The user who owns this payment method.
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Transactions using this payment method.
  transactions Transaction[]

  /// Timestamp of payment method creation.
  createdAt DateTime @default(now())

  /// Timestamp of the last update to any payment method field.
  updatedAt DateTime @updatedAt

  /// Index for querying payment methods by user.
  @@index([userId])

  /// Composite index for efficiently finding the default payment method per user.
  @@index([userId, isDefault])

  /// Map the model to the "payment_methods" table in PostgreSQL.
  @@map("payment_methods")
}

/// Financial transaction record (income, expense, or transfer).
model Transaction {
  /// Unique transaction identifier (UUID v4).
  id        String          @id @default(uuid()) @db.Uuid

  /// Whether this is an income, expense, or transfer.
  type      TransactionType

  /// Monetary amount of the transaction (must be > 0).
  amount    Float

  /// Short description of the transaction (1–500 chars).
  description String

  /// The calendar date the transaction occurred (YYYY-MM-DD).
  date      DateTime        @db.Date

  /// Optional additional notes about the transaction.
  notes     String?

  /// Foreign key to the assigned category.
  categoryId String          @db.Uuid

  /// The category this transaction belongs to.
  category  Category         @relation(fields: [categoryId], references: [id])

  /// Foreign key to the payment method used (nullable for cash/unspecified).
  paymentMethodId String?    @db.Uuid

  /// The payment method used for this transaction.
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  /// Foreign key to the owning user.
  userId    String           @db.Uuid

  /// The user who owns this transaction.
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Timestamp of record creation.
  createdAt DateTime @default(now())

  /// Timestamp of the last update to any transaction field.
  updatedAt DateTime @updatedAt

  /// Primary query pattern: user's transactions ordered by date.
  @@index([userId, date])

  /// User's transactions filtered by category.
  @@index([userId, categoryId])

  /// Query transactions across users by category.
  @@index([categoryId])

  /// Date-range queries and sorting.
  @@index([date])

  /// Map the model to the "transactions" table in PostgreSQL.
  @@map("transactions")
}

/// Budget target for a specific category and time period.
model Budget {
  /// Unique budget identifier (UUID v4).
  id        String       @id @default(uuid()) @db.Uuid

  /// Spending limit for the period (must be >= 0).
  targetAmount Float

  /// Percentage threshold that triggers a warning alert (default 80%).
  alertThreshold Int     @default(80)

  /// The recurrence period of this budget (default: monthly).
  period    BudgetPeriod @default(MONTHLY)

  /// Start date of the budget period (e.g. first day of the month).
  startDate DateTime     @db.Date

  /// Foreign key to the category this budget targets.
  categoryId String      @db.Uuid

  /// The category this budget is set for.
  category  Category     @relation(fields: [categoryId], references: [id])

  /// Foreign key to the owning user.
  userId    String       @db.Uuid

  /// The user who owns this budget.
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Timestamp of budget creation.
  createdAt DateTime @default(now())

  /// Timestamp of the last update to any budget field.
  updatedAt DateTime @updatedAt

  /// One budget per category per period per user.
  @@unique([userId, categoryId, startDate])

  /// Query budgets by user and period start date.
  @@index([userId, startDate])

  /// Query budgets by category.
  @@index([categoryId])

  /// Map the model to the "budgets" table in PostgreSQL.
  @@map("budgets")
}

/// In-app notification record for a user.
model Notification {
  /// Unique notification identifier (UUID v4).
  id        String           @id @default(uuid()) @db.Uuid

  /// The category of notification.
  type      NotificationType

  /// Short notification title (e.g. "Budget Alert", "Export Ready").
  title     String

  /// Full notification body text.
  message   String

  /// Whether the user has read/dismissed this notification.
  read      Boolean          @default(false)

  /// Foreign key to the owning user.
  userId    String           @db.Uuid

  /// The user who owns this notification.
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Timestamp of notification creation.
  createdAt DateTime @default(now())

  /// Query unread notifications for a user.
  @@index([userId, read])

  /// Query notifications in chronological order.
  @@index([userId, createdAt])

  /// Map the model to the "notifications" table in PostgreSQL.
  @@map("notifications")
}

/// User-defined savings goal tracking progress toward a financial target.
model SavingsGoal {
  /// Unique savings goal identifier (UUID v4).
  id            String   @id @default(uuid()) @db.Uuid

  /// Goal name (e.g. "Emergency Fund", "New Laptop").
  name          String

  /// Target amount to save.
  targetAmount  Float

  /// Current amount saved so far.
  currentAmount Float    @default(0)

  /// Optional target date to reach the goal.
  deadline      DateTime? @db.Date

  /// Lucide icon identifier for the goal.
  icon          String   @default("PiggyBank")

  /// Hex color code for the goal (e.g. "#10B981").
  color         String   @default("#10B981")

  /// Foreign key to the owning user.
  userId        String   @db.Uuid

  /// The user who owns this savings goal.
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Timestamp of goal creation.
  createdAt DateTime @default(now())

  /// Timestamp of the last update to any goal field.
  updatedAt DateTime @updatedAt

  /// Query savings goals by user.
  @@index([userId])

  /// Map the model to the "savings_goals" table in PostgreSQL.
  @@map("savings_goals")
}
