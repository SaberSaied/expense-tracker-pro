// ─── Datasource & Generator ──────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentMethodType {
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BANK_TRANSFER
  DIGITAL_WALLET
}

enum Currency {
  USD
  EUR
  GBP
  EGP
  CAD
  AUD
  JPY
  CHF
  CNY
  INR
  BRL
  MXN
  KRW
  SEK
  NOK
  DKK
  NZD
  SGD
  HKD
  SAR
  AED
}

// ─── Models ──────────────────────────────────────────────────

/// Registered application user.
model User {
  /// Unique user identifier (UUID v4).
  id        String   @id @default(uuid()) @db.Uuid

  /// Unique email address used for login and communication.
  email     String   @unique

  /// Bcrypt-hashed password (never stored in plain text).
  passwordHash String

  /// Optional display name shown in profile and UI.
  name      String?

  /// Optional short biography.
  bio       String?

  /// Optional URL to the user's avatar image.
  avatarUrl String?

  /// Preferred currency for displaying monetary values.
  currency  Currency @default(USD)

  /// Preferred locale string (e.g. "en-US", "ar-EG").
  language  String   @default("en-US")

  /// Preferred date format string (e.g. "YYYY-MM-DD", "MM/DD/YYYY").
  dateFormat String  @default("YYYY-MM-DD")

  /// JSON object storing notification preference flags:
  ///   { "budgetAlerts": bool, "emailWarnings": bool, "weeklyDigest": bool }
  notifications Json  @default("{\"budgetAlerts\":true,\"emailWarnings\":true,\"weeklyDigest\":false}")

  /// Whether the user's email address has been verified.
  emailVerified Boolean @default(false)

  /// Timestamp of account creation.
  createdAt DateTime @default(now())

  /// Timestamp of the last update to any user field.
  updatedAt DateTime @updatedAt

  /// The user's custom spending categories.
  categories Category[]

  /// The user's saved payment methods.
  paymentMethods PaymentMethod[]

  /// Index for efficient querying and sorting by creation date.
  @@index([createdAt])

  /// Map the model to the "users" table in PostgreSQL.
  @@map("users")
}

/// Spending category associated with a user.
model Category {
  /// Unique category identifier (UUID v4).
  id        String  @id @default(uuid()) @db.Uuid

  /// Display name of the category (e.g. "Food & Dining", "Transportation").
  name      String

  /// Lucide icon identifier for the category.
  icon      String  @default("Tag")

  /// Hex color code for the category (e.g. "#F59E0B").
  color     String  @default("#6366F1")

  /// Whether this is a predefined system category (protected from deletion).
  isSystem  Boolean @default(false)

  /// Foreign key to the owning user.
  userId    String  @db.Uuid

  /// The user who owns this category.
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Timestamp of category creation.
  createdAt DateTime @default(now())

  /// Timestamp of the last update to any category field.
  updatedAt DateTime @updatedAt

  /// Category names must be unique per user.
  @@unique([name, userId])

  /// Index for querying categories by user.
  @@index([userId])

  /// Map the model to the "categories" table in PostgreSQL.
  @@map("categories")
}

/// Saved payment method associated with a user.
model PaymentMethod {
  /// Unique payment method identifier (UUID v4).
  id        String           @id @default(uuid()) @db.Uuid

  /// The type of payment method.
  type      PaymentMethodType

  /// User-friendly label (e.g. "My Chase Credit Card", "Personal Checking").
  name      String

  /// Whether this is the user's default payment method.
  isDefault Boolean          @default(false)

  /// Optional last 4 digits of the card or account number for display.
  lastFour  String?

  /// Foreign key to the owning user.
  userId    String           @db.Uuid

  /// The user who owns this payment method.
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Timestamp of payment method creation.
  createdAt DateTime @default(now())

  /// Timestamp of the last update to any payment method field.
  updatedAt DateTime @updatedAt

  /// Index for querying payment methods by user.
  @@index([userId])

  /// Composite index for efficiently finding the default payment method per user.
  @@index([userId, isDefault])

  /// Map the model to the "payment_methods" table in PostgreSQL.
  @@map("payment_methods")
}
