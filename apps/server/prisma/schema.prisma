// ─── Datasource & Generator ──────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Currency {
  USD
  EUR
  GBP
  EGP
  CAD
  AUD
  JPY
  CHF
  CNY
  INR
  BRL
  MXN
  KRW
  SEK
  NOK
  DKK
  NZD
  SGD
  HKD
  SAR
  AED
}
