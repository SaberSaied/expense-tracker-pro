# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=4000
NODE_ENV="production"
APP_NAME="ExpenseTracker"
APP_VERSION="1.0.0"
LOG_LEVEL="info"

# ─── Database Connections (Neon PostgreSQL) ──────────────────────────────────
# Pooled connection string (pgBouncer) used by Express runtime:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_tracker?sslmode=require&pgbouncer=true"

# Direct connection string (Unpooled) used for Prisma migrations:
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/expense_tracker?sslmode=require"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="expense_tracker"

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate a strong secret with: openssl rand -hex 64
# MUST be set to a unique value in production — the server refuses to
# boot with the default placeholder in NODE_ENV=production.
JWT_SECRET="change-me-in-production-use-a-real-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (production is strict).
CORS_ORIGIN="https://your-frontend.vercel.app"

# ─── Proxy ────────────────────────────────────────────────────────────────────
# How many reverse-proxy hops to trust for client IPs (rate limiting).
# Set to "1" on Render / reverse proxy providers. Defaults to "1" in production.
TRUST_PROXY="1"

# ─── Background Jobs (optional) ───────────────────────────────────────────────
# Secret used to guard manual job triggers (x-jobs-token header).
JOBS_TRIGGER_TOKEN=""

# ─── Email / SMTP (optional) ──────────────────────────────────────────────────
# Used for password-reset emails.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@expensetracker.com"
