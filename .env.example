# ─── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV="development"
APP_NAME="ExpenseTracker"
APP_VERSION="1.0.0"

# ─── Database ──────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/expense_tracker"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5433
POSTGRES_DB="expense_tracker"

# ─── Auth / JWT ────────────────────────────────────────────────
# Generate a strong secret with: openssl rand -hex 64
# MUST be set to a unique value in production — the server refuses to
# boot with the placeholder in NODE_ENV=production.
JWT_SECRET="change-me-in-production-use-a-real-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins (production is strict; in
# development any localhost origin is accepted automatically).
CORS_ORIGIN="http://localhost:5173"

# ─── Proxy ─────────────────────────────────────────────────────
# How many reverse-proxy hops to trust for client IPs (rate limiting).
# "false" = don't trust proxy headers; "1" = one hop (nginx/caddy).
# Defaults to "1" in production, "false" otherwise. Never "true".
TRUST_PROXY="false"

# ─── Background Jobs (optional) ────────────────────────────────
# Secret used to guard manual job triggers (x-jobs-token header).
JOBS_TRIGGER_TOKEN=""

# ─── Email / SMTP (optional) ───────────────────────────────────
# Used for password-reset emails. If unset, reset tokens are logged
# in non-production environments only.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@expensetracker.com"
